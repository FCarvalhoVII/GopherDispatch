HTTP_PORT=8080
DATABASE_URL=postgres://gopherqueue:gopherqueue@localhost:5432/gopherqueue?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDIS_CONSUMER_GROUP=gopherqueue-workers
WORKER_COUNT=4
WORKER_POLL_INTERVAL=500ms
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
PENDING_IDLE_TIMEOUT=30s
PRIORITY_HIGH_WEIGHT=5
PRIORITY_MEDIUM_WEIGHT=3
PRIORITY_LOW_WEIGHT=1
MAX_JOB_ATTEMPTS=3
JOB_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
REQUEST_BODY_LIMIT=1048576
RATE_LIMIT_PER_MINUTE=120

